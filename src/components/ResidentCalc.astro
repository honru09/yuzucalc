---
import { residentTax, listMunicipalities } from '../lib/engine/index.ts';
import { yen } from '../lib/ui.ts';

interface Props { lang: 'ja' | 'en' }
const { lang } = Astro.props;
const ja = lang === 'ja';
const t = ja
  ? {
      gross: '前年の年収（額面）', si: '前年の社会保険料', siAuto: '社会保険料は年収から概算',
      spouse: '配偶者控除あり（配偶者の所得48万円以下）',
      depGeneral: '扶養親族（一般）', depSpecific: '特定扶養（19〜22歳）', depElderly: '老人扶養（別居）', depCohabit: '老人扶養（同居）',
      municipality: 'お住まいの市区町村', standard: '標準（全国標準税率）',
      result: '住民税（令和8年度・令和7年分の所得に課税）',
      rows: {
        salaryIncome: '給与所得', taxable: '課税所得', shotoku: '所得割', adjustment: 'うち調整控除',
        kinto: '均等割', forest: '森林環境税', annual: '住民税（年額）', monthly: '月額（特別徴収・7月〜翌5月）', june: '6月分（端数を含む）',
      },
      note: '標準税率で計算しています。超過課税のある市区町村（横浜・神戸・名古屋・福岡・札幌・宮城県・大阪市・豊岡市）は選択肢から選べます。大阪市の府民税均等割には令和9年度までの300円加算が含まれます。',
    }
  : {
      gross: 'Last year\u2019s gross salary', si: 'Last year\u2019s social insurance', siAuto: 'Estimate social insurance from salary',
      spouse: 'Spouse deduction (spouse income <= ¥480,000)',
      depGeneral: 'Dependents (general)', depSpecific: 'Dependents 19-22 (specific)', depElderly: 'Elderly dependents (separate)', depCohabit: 'Elderly dependents (same household)',
      municipality: 'Municipality of residence', standard: 'Standard (national standard rates)',
      result: 'Resident tax (FY2026 levy, on 2025 income)',
      rows: {
        salaryIncome: 'Employment income', taxable: 'Taxable income', shotoku: 'Income levy (shotokuwari)', adjustment: 'of which adjustment credit',
        kinto: 'Per-capita levy (kintowari)', forest: 'Forest environment tax', annual: 'Resident tax (annual)', monthly: 'Monthly (payroll, Jul-May)', june: 'June instalment (incl. remainder)',
      },
      note: 'Computed at standard rates. Municipalities with verified surtaxes (Yokohama, Kobe, Nagoya, Fukuoka, Sapporo, Miyagi Prefecture, Osaka City, Toyooka) can be selected. Osaka City\u2019s prefectural levy includes a ¥300 surcharge through FY2027.',
    };

const municipalities = listMunicipalities();
const def = residentTax({ grossSalary: 4800000, socialInsurance: 700000, incomeYear: 'r7' });
---

<div class="grid2">
  <div class="card">
    <form class="calc" id="rt-form">
      <label class="unit" data-unit={ja ? '円' : 'JPY'}>{t.gross}<input name="gross" type="number" inputmode="numeric" min="0" step="10000" value="4800000" /></label>
      <label class="unit" data-unit={ja ? '円' : 'JPY'}>{t.si}<input name="si" type="number" inputmode="numeric" min="0" step="1000" value="700000" /></label>
      <label>{t.municipality}
        <select name="municipality">
          <option value="">{t.standard}</option>
          {municipalities.map((m) => <option value={m.municipality}>{ja ? m.municipality : `${m.municipality} (${m.prefecture})`}</option>)}
        </select>
      </label>
      <label>{t.depGeneral}<input name="depGeneral" type="number" inputmode="numeric" min="0" max="10" value="0" /></label>
      <label>{t.depSpecific}<input name="depSpecific" type="number" inputmode="numeric" min="0" max="10" value="0" /></label>
      <label>{t.depElderly}<input name="depElderly" type="number" inputmode="numeric" min="0" max="10" value="0" /></label>
      <label>{t.depCohabit}<input name="depCohabit" type="number" inputmode="numeric" min="0" max="10" value="0" /></label>
      <label style="display:flex; gap:8px; align-items:center"><input name="spouse" type="checkbox" style="width:auto" /> {t.spouse}</label>
    </form>
    <p class="src" style="margin-top:14px">{t.note}</p>
  </div>
  <div class="card result" id="rt-result" aria-live="polite">
    <div class="result-head">
      <div class="src" style="font-weight:700; letter-spacing:.06em">{t.result}</div>
      <button type="button" class="btn ghost noprint" onclick="window.print()">{ja ? '結果を印刷' : 'Print result'}</button>
    </div>
    <div class="net-big"><span data-v="annual">{yen(def.annual)}</span> <span class="unit">/ {ja ? '年' : 'year'}</span></div>
    <table class="breakdown"><tbody>
      <tr class="sub"><td>{t.rows.salaryIncome}</td><td class="v num" data-v="salaryIncome">{yen(def.salaryIncome)}</td></tr>
      <tr class="sub"><td>{t.rows.taxable}</td><td class="v num" data-v="taxable">{yen(def.taxableIncome)}</td></tr>
      <tr><td>{t.rows.shotoku}（<span data-v="rate">{def.shotokuwariRatePct}</span>%）</td><td class="v num" data-v="shotoku">{yen(def.shotokuwari)}</td></tr>
      <tr class="sub"><td>{t.rows.adjustment}</td><td class="v num" data-v="adjustment">−{yen(def.adjustment)}</td></tr>
      <tr><td>{t.rows.kinto}</td><td class="v num" data-v="kinto">{yen(def.kintowari)}</td></tr>
      <tr><td>{t.rows.forest}</td><td class="v num" data-v="forest">{yen(def.forestEnvTax)}</td></tr>
      <tr class="total"><td>{t.rows.annual}</td><td class="v num" data-v="annual2">{yen(def.annual)}</td></tr>
      <tr><td>{t.rows.monthly}</td><td class="v num" data-v="monthly">{yen(def.monthlyInstalment)}</td></tr>
      <tr><td>{t.rows.june}</td><td class="v num" data-v="june">{yen(def.juneInstalment)}</td></tr>
    </tbody></table>
  </div>
</div>
<div class="sticky-net" aria-hidden="true">
  <span>{t.rows.annual}<span class="lbl">/ {ja ? '年' : 'year'}</span></span>
  <strong data-sticky>{yen(def.annual)}</strong>
</div>

<script>
  import { residentTax, monthlyPremiums, type DependentType } from '../lib/engine/index.ts';
  import { yen, setText, queryParams, syncQuery, field, fieldNum, countUpYen, flash } from '../lib/ui.ts';
  const form = document.getElementById('rt-form') as HTMLFormElement;
  const result = document.getElementById('rt-result') as HTMLElement;
  function applyQuery() {
    const q = queryParams();
    const names = ['gross', 'si', 'municipality', 'depGeneral', 'depSpecific', 'depElderly', 'depCohabit'];
    for (const n of names) if (q[n] != null) field(form, n).value = q[n];
    if (q.spouse != null) (field(form, 'spouse') as HTMLInputElement).checked = q.spouse === '1';
  }
  function compute() {
    const deps: DependentType[] = [];
    const push = (name: string, type: DependentType) => {
      const c = Math.min(10, Math.max(0, Math.floor(fieldNum(form, name, 0))));
      for (let i = 0; i < c; i++) deps.push(type);
    };
    push('depGeneral', 'general'); push('depSpecific', 'specific'); push('depElderly', 'elderly'); push('depCohabit', 'elderlyCohabit');
    const gross = Math.max(0, fieldNum(form, 'gross', 0));
    const mun = field(form, 'municipality').value;
    const r = residentTax({
      grossSalary: gross,
      socialInsurance: Math.max(0, fieldNum(form, 'si', 0)),
      spouse: (field(form, 'spouse') as HTMLInputElement).checked,
      dependents: deps,
      municipality: mun === '' ? undefined : mun,
      incomeYear: 'r7',
    });
    countUpYen(result.querySelector('[data-v="annual"]'), r.annual); setText(result, 'annual2', yen(r.annual));
    const sticky = document.querySelector('[data-sticky]');
    if (sticky) sticky.textContent = yen(r.annual);
    setText(result, 'salaryIncome', yen(r.salaryIncome));
    setText(result, 'taxable', yen(r.taxableIncome));
    setText(result, 'shotoku', yen(r.shotokuwari));
    setText(result, 'rate', String(r.shotokuwariRatePct));
    setText(result, 'adjustment', '−' + yen(r.adjustment));
    setText(result, 'kinto', yen(r.kintowari));
    setText(result, 'forest', yen(r.forestEnvTax));
    setText(result, 'monthly', yen(r.monthlyInstalment));
    setText(result, 'june', yen(r.juneInstalment));
    syncQuery({
      gross, si: fieldNum(form, 'si', 0), municipality: mun === '' ? null : mun,
      depGeneral: fieldNum(form, 'depGeneral', 0), depSpecific: fieldNum(form, 'depSpecific', 0),
      depElderly: fieldNum(form, 'depElderly', 0), depCohabit: fieldNum(form, 'depCohabit', 0),
      spouse: (field(form, 'spouse') as HTMLInputElement).checked ? 1 : null,
    });
  }
  applyQuery();
  form.addEventListener('input', compute);
  form.addEventListener('change', compute);
  form.addEventListener('change', () => flash(result));
  compute();
</script>
